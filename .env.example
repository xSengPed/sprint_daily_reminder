# ---------- ใช้ตอน deploy ด้วย docker compose ----------
# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่า (ไฟล์ .env ถูก gitignore ไว้)
MONGODB_URI=mongodb://admin:password@10.0.0.141:27017/?authSource=admin
MONGODB_DB=sprint_reminder

# พอร์ตที่เปิดออกนอกเครื่อง (Caddy)
HTTP_PORT=80

# เว็บกับ API อยู่ origin เดียวกันผ่าน Caddy — ปกติไม่ต้องแก้
NEXT_PUBLIC_API_URL=/api
CORS_ORIGIN=http://localhost

# ---------- ใช้ตอนรัน dev ในเครื่อง (ใส่ใน .env.local) ----------
# NEXT_PUBLIC_API_URL=http://localhost:4000/api
