# ---------- ใช้ตอน deploy ด้วย docker compose ----------
# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่า (ไฟล์ .env ถูก gitignore ไว้)
# backend deploy แยก stack ต่างหาก (ดู sprint_reminder_backend) — compose นี้มีแค่ frontend + Caddy

# พอร์ตที่เปิดออกนอกเครื่อง (Caddy)
HTTP_PORT=80

# ที่อยู่ backend stack ที่ deploy ไว้แล้ว — ถ้าอยู่เครื่องเดียวกันใช้ค่าเริ่มต้นได้เลย
# (host.docker.internal ชี้กลับไปที่ host เอง ส่วน backend publish พอร์ต 4000 ไว้ที่ host แล้ว)
BACKEND_ADDR=host.docker.internal:4000

# เว็บกับ API อยู่ origin เดียวกันผ่าน Caddy — ปกติไม่ต้องแก้
NEXT_PUBLIC_API_URL=/api

# ---------- ใช้ตอนรัน dev ในเครื่อง (ใส่ใน .env.local) ----------
# NEXT_PUBLIC_API_URL=http://localhost:4000/api
